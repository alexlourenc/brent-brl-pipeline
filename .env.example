# Copie este arquivo para .env e preencha os valores.
# Copy this file to .env and fill in the values.

# Chave gratuita: https://www.eia.gov/opendata/register.php
EIA_API_KEY=coloque_sua_chave_aqui

# Periodo da extracao (AAAA-MM-DD). DATA_FIM vazio = hoje.
DATA_INICIO=2024-01-01
DATA_FIM=

# Nivel de log: DEBUG, INFO, WARNING
LOG_LEVEL=INFO

# Cliente HTTP (opcional: vazio = valor padrao)
# Total de tentativas por chamada (padrao 4)
HTTP_MAX_TENTATIVAS=
# Base do backoff em segundos: 1s, 2s, 4s... (padrao 1.0)
HTTP_BACKOFF_BASE_S=
# Intervalo minimo entre chamadas, em segundos (padrao 1.0)
HTTP_INTERVALO_MIN_S=
# Tempo maximo de espera por resposta, em segundos (padrao 30)
HTTP_TIMEOUT_S=
